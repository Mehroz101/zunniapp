# ─────────────────────────────────────────────
# TOOLty — Hostinger & Production Environment Variables
# ─────────────────────────────────────────────

PORT=3000
NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://toolty.online
NEXT_PUBLIC_APP_NAME="TOOLty"

# Database (MongoDB Atlas connection string)
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/aiiseverything?retryWrites=true&w=majority"

# Backend API on Vercel
NEXT_PUBLIC_API_URL=https://aiiseverythingback.vercel.app/api/v1

# Cache Revalidation Secret
REVALIDATE_SECRET=toolty_secure_revalidate_secret_2026

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=

# Feature Flags
NEXT_PUBLIC_ENABLE_BLOG=true
NEXT_PUBLIC_ENABLE_AI_CHAT=false
