# ─────────────────────────────────────────────
# apps/web — Frontend Environment Variables
# Copy to .env.local for local development
# ─────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="AIIsEverything"

# Database (MongoDB connection string for direct SSR/ISR queries)
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/aiiseverything?retryWrites=true&w=majority"

# API (Production: https://aiiseverythingback.vercel.app/api/v1 | Local: http://localhost:4000/api/v1)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Analytics (add real values in production)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=

# Feature Flags
NEXT_PUBLIC_ENABLE_BLOG=true
NEXT_PUBLIC_ENABLE_AI_CHAT=false
